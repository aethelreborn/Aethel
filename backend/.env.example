DATABASE_URL="postgresql://postgres:password@localhost:5432/aethel"
JWT_SECRET="change-this-to-a-random-64-char-string-at-least"
JWT_REFRESH_SECRET="change-this-refresh-secret-to-something-long-too"
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# ── Firebase Cloud Messaging (optional — push notifications) ──────────────────
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Download the JSON, extract these 3 values:
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── AethelPay payment gateway (optional — freemium premium upgrades) ──────────
# AETHEL_PAY_MERCHANT_KEY is required for /payments/checkout and /payments/verify;
# without it those endpoints return 503 PAYMENTS_NOT_CONFIGURED. Generate with:
#   openssl rand -hex 32
# It must match the merchant API key registered on the gateway.
AETHEL_PAY_GATEWAY_URL="http://127.0.0.1:6100"
AETHEL_PAY_MERCHANT_ID="00000000-0000-0000-0000-000000000001"
AETHEL_PAY_MERCHANT_KEY=
AETHEL_PAY_RETURN_URL="http://localhost:3000"
